# Copy to .env and adjust. Never commit .env. All settings are optional for local mode.
BP_ENV=local
BP_DATA_DIR=data
BP_WAREHOUSE_PATH=data/warehouse/businesspulse.duckdb
BP_APP_DB_PATH=data/state/app_state.sqlite
BP_LOG_LEVEL=INFO

# Sources
BP_ENABLE_SYNTHETIC=true          # false = inventory/marketing modules disabled (no synthetic data)
BP_ENABLE_FX_API=true             # Frankfurter (ECB) FX rates; offline -> skipped gracefully
BP_SYNTHETIC_SEED=42

# Object storage: local | s3 (AWS S3 or MinIO)
BP_STORAGE_BACKEND=local
BP_S3_BUCKET=
BP_S3_ENDPOINT_URL=               # e.g. http://minio:9000 for MinIO; empty for AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-2

# Serving layer for Superset / Power BI (optional)
BP_POSTGRES_DSN=                  # e.g. host=postgres dbname=businesspulse user=bp password=***

# Streaming / connectors (optional)
BP_KAFKA_BOOTSTRAP=               # e.g. kafka:9092 ; empty -> local file bus
BP_KAFKA_TOPIC=retail.transactions
BP_AIRBYTE_URL=
BP_AIRBYTE_TOKEN=

# Lineage / ML tracking (optional)
OPENLINEAGE_URL=                  # e.g. http://marquez:5000
OPENLINEAGE_NAMESPACE=businesspulse
MLFLOW_TRACKING_URI=              # empty -> local file store data/mlruns

# Optional LLM phrasing of insights (never required)
BP_LLM_PROVIDER=                  # anthropic
BP_LLM_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=

# App security: demo (pick a synthetic identity) | password (hashes below)
BP_AUTH_MODE=demo
BP_SQL_ROW_LIMIT=5000
# BP_USER_DANA_ANALYST_SHA256=<sha256 of password>
# BP_USER_BEN_BA_SHA256=
# BP_USER_MAYA_MANAGER_SHA256=
# BP_USER_ALEX_ADMIN_SHA256=

# docker-compose service credentials (change before any shared deployment)
POSTGRES_USER=bp
POSTGRES_PASSWORD=change-me
MINIO_ROOT_USER=bpminio
MINIO_ROOT_PASSWORD=change-me-too
AIRFLOW_ADMIN_PASSWORD=change-me
GRAFANA_ADMIN_PASSWORD=change-me
SUPERSET_SECRET_KEY=generate-a-long-random-string
